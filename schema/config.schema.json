{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/stuplum/premise/schema/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions", "reports"],
  "properties": {
    "decisions": { "type": "string", "minLength": 1 },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "path"],
        "properties": {
          "format": { "enum": ["junit", "cucumber-json", "dependency-cruiser"] },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gherkin": { "type": "string", "minLength": 1 },
    "dependency_cruiser_config": { "type": "string", "pattern": "\\.json$" },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "allowed"],
      "properties": {
        "default": { "$ref": "#/definitions/signoff" },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/signoff" }
        }
      }
    },
    "classifiers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/definitions/classifier" }
    }
  },
  "definitions": {
    "signoff": { "type": "string", "pattern": "^(human|none|classifier:[a-z][a-z0-9-]*)$" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["established", "failed"],
      "properties": {
        "established": { "type": "number", "minimum": 0, "maximum": 1 },
        "failed": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "classifier": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "model", "thresholds"],
          "properties": {
            "adapter": { "const": "jev" },
            "model": { "type": "string", "pattern": "^jev-\\d+\\.\\d+\\.\\d+$" },
            "thresholds": { "$ref": "#/definitions/thresholds" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "command", "model", "thresholds"],
          "properties": {
            "adapter": { "const": "command" },
            "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "model": { "type": "string", "minLength": 1 },
            "thresholds": { "$ref": "#/definitions/thresholds" }
          }
        }
      ]
    }
  }
}
