{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/stuplum/premise/schema/decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "date", "context", "options", "decision", "because", "consequences"],
  "properties": {
    "id": { "$ref": "#/definitions/identifier" },
    "title": { "$ref": "#/definitions/text" },
    "status": { "enum": ["proposed", "accepted", "superseded"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "context": { "$ref": "#/definitions/text" },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "$ref": "#/definitions/text" },
          "pros": { "$ref": "#/definitions/texts" },
          "cons": { "$ref": "#/definitions/texts" }
        }
      }
    },
    "decision": { "$ref": "#/definitions/text" },
    "because": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
    "consequences": { "$ref": "#/definitions/texts" },
    "scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/text" } },
    "supported_by": { "$ref": "#/definitions/checks" },
    "enforced_by": { "$ref": "#/definitions/checks" },
    "signoff": { "type": "string", "pattern": "^(human|none|classifier:[a-z][a-z0-9-]*)$" },
    "owners": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" }
    },
    "supersedes": { "$ref": "#/definitions/identifier" }
  },
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "texts": { "type": "array", "items": { "$ref": "#/definitions/text" } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check"],
        "properties": {
          "check": { "$ref": "#/definitions/identifier" },
          "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
