{
  "name": "@stuplum/premise",
  "version": "0.3.0",
  "description": "Links architecture decisions to the results of a repository's own checks, and reports when a decision is violated, needs reconsidering or has gone stale.",
  "keywords": [
    "architecture-decisions",
    "adr",
    "junit",
    "cucumber",
    "dependency-cruiser",
    "developer-tools"
  ],
  "author": "stuplum",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuplum/premise.git"
  },
  "bugs": {
    "url": "https://github.com/stuplum/premise/issues"
  },
  "homepage": "https://github.com/stuplum/premise#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "premise": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "reports": "mkdir -p reports && node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit.xml test/*.test.ts && depcruise src --config .dependency-cruiser.json --output-type json --output-to reports/depcruise.json",
    "check:premise": "node dist/cli.js check",
    "verify": "pnpm typecheck && pnpm build && pnpm reports && pnpm check:premise",
    "prepare": "npm run build",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@cucumber/gherkin": "^38.0.0",
    "@cucumber/messages": "^32.3.1",
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.11.2",
    "glob": "^13.0.6",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "16.10.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "sideEffects": false
}
